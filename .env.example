# ---- OpenRouter (AI-written reactions) ----
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Optional. If you do not set it, this free model is used:
#   nvidia/nemotron-3-ultra-550b-a55b:free
# To use another model, copy its id from https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---- Supabase (stores the shared posters + share links) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role_key...
# Optional. Default is biodata-images
SUPABASE_BUCKET=biodata-images

# ---- Site URL (used for Facebook share links and og:image) ----
# Set this to your final domain, e.g. https://amar-biyer-biodata.vercel.app
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN
